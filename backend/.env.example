# ==========================================
# SOPET Momentum Backend Environment Variables
# ==========================================

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Explicit local/staging command only: npm run admin:bootstrap
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=SYSTEM_OWNER

# PostgreSQL Database (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/sopet_momentum?schema=public
# Example Cloud (Supabase/Neon/Cloud SQL): postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sopet_momentum?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=sopet_super_secure_access_secret_change_in_production_2026!
JWT_REFRESH_SECRET=sopet_super_secure_refresh_secret_change_in_production_2026!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie Security (in production: secure=true, sameSite=strict)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
ENABLE_SWAGGER=false
# Explicit development-only fallback. Never set these in staging or production.
DEV_ALLOW_MEMORY_USERS=false
DEV_MEMORY_USER_PASSWORD=

# Google Gemini AI Integration (Backend only - never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis is mandatory in production; development may use an in-memory fallback.
REDIS_URL=

# Email Delivery (Console logger for dev; SMTP or transactional API in production)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@sopet-momentum.org
# Production: EMAIL_PROVIDER=resend (console is rejected)
# EMAIL_API_KEY=re_your_server_side_key

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
